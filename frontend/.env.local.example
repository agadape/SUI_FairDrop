# Copy to .env.local and fill in after deploying contracts.
# Live testnet IDs are listed in the repo README under "Deployed on testnet".

# FairDrop — first policy (sealed-bid fair launch)
NEXT_PUBLIC_PACKAGE_ID=0x...
NEXT_PUBLIC_AUCTION_ID=0x...

# Umbra — second policy (confidential MEV-resistant settlement)
NEXT_PUBLIC_UMBRA_PACKAGE_ID=0x...
NEXT_PUBLIC_UMBRA_POOL_ID=0x...

# Enoki PUBLIC key from https://portal.enoki.mystenlabs.com
# Used for zkLogin auth only (walletless Google login). NOT sponsorship —
# txs are self-paid in this MVP (sponsorship needs a private key + server).
NEXT_PUBLIC_ENOKI_API_KEY=enoki_public_...

# Google OAuth client ID (for zkLogin)
# Create at https://console.cloud.google.com -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=....apps.googleusercontent.com
